# ──────────────────────────────────────────────
# SAVJ — Environment Variables
# Copy this to .env and fill in real values.
# Never commit .env to version control.
# ──────────────────────────────────────────────

# Application
APP_ENV=development
APP_NAME=SAVJ API
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=*

# Database (overridden by docker-compose for containers)
DATABASE_URL=postgresql+asyncpg://savj:savj_dev_pass@localhost:5432/savj
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — CHANGE THIS IN PRODUCTION
JWT_SECRET=dev-only-secret-change-me-to-64-random-chars-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Object Storage (MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=savj-uploads
STORAGE_USE_SSL=false

# AI Service
AI_SERVICE_URL=http://localhost:8001
AI_TIMEOUT_SECONDS=30

# Firebase — set USE_MOCK_NOTIFICATION=false and provide credentials for real FCM
USE_MOCK_NOTIFICATION=true
FIREBASE_CREDENTIALS_PATH=

# Payment — set PAYMENT_MODE=razorpay and provide keys for real payments
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (SMTP) — for password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@savj.in
SMTP_USE_TLS=true

# Development helpers
DEV_BYPASS_EMAIL_VERIFICATION=true

# Test database (used by pytest)
TEST_DATABASE_URL=postgresql+asyncpg://savj:savj_dev_pass@localhost:5432/savj_test
